# Linux 6.6 LTS · qemu-aarch64 CI 冒烟内核基线片段
#
# 依据:docs/linux-内核裁剪方案.md v0.0.7
# 用途:与 arm64 defconfig 合并后产出 CI 冒烟内核 .config
# 加载:scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig <本片段>
#
# 红线:CI 不含接入位硬件驱动 / 不含内核模块 / 不含 cgroup v1 / 不含主机目录共享

# ===== 强制开启 =====

# 1 TCP / UDP / IPv4 / IPv6
CONFIG_INET=y
CONFIG_IPV6=y

# 2 ICMP / ping
# 注:ICMP 是 CONFIG_INET 子项,无独立 CONFIG_ICMP
# CONFIG_INET=y 已包含(见 #1 段)

# 3 unix domain socket / packet socket / netlink
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NET=y

# 4 loopback / bridge
CONFIG_LOOPBACK=y
CONFIG_BRIDGE=y

# 10 ext4
CONFIG_EXT4_FS=y

# 11 tmpfs / devtmpfs / devpts / sysfs / proc / configfs
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_CONFIGFS_FS=y

# 19 namespaces(PID/NET/IPC/UTS/USER/MOUNT/CGROUP/TIME)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_MNT_NS=y
CONFIG_CGROUP_NS=y

# 20 seccomp BPF
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# 21 capabilities(MULTIUSER 隐含)
CONFIG_MULTIUSER=y

# 22 AppArmor
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y

# 24 Yama
CONFIG_SECURITY_YAMA=y

# 28 printk / magic SysRq / IKCONFIG
CONFIG_PRINTK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# 34 pipe / unix socket / eventfd / signalfd / timerfd / inotify / fanotify / epoll
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
# 注:CONFIG_UNIX=y 已在 #3 段定义,本段不重复

# 37 POSIX shmem(隐含在 TMPFS,无独立 CONFIG_)
# 注:CI/E2E 均无独立 CONFIG_,TMPFS_POSIX_ACL=y(#11 段)覆盖

# 38 遗留 IPC(全裁)
# 注:无独立 CONFIG_,Linux 6.6 已无 SysV IPC 之外的遗留 IPC 开关
# 全裁通过 SYSVIPC=n(在 #35)和 POSIX_MQUEUE=n(在 #36)落实

# 39 virtio-blk / virtio-scsi / loop
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y

# 40 io_uring
CONFIG_IO_URING=y

# 45 virtio-net / loopback
CONFIG_VIRTIO_NET=y

# 47 virtio-balloon
CONFIG_VIRTIO_BALLOON=y

# 52 virtio-console
CONFIG_VIRTIO_CONSOLE=y

# 53 8250 / pl011 / AMBA-pl011 串口
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# 63 RTC(pl031 / rtc-generic)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_DRV_GENERIC=y

# 64 CPU frequency / cpuidle
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_IDLE=y

# 65 virtio-rng
CONFIG_HW_RANDOM_VIRTIO=y

# 67 THP / hugetlb / KSM
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y
CONFIG_KSM=y

# 72 CFS + SCHED_NORMAL/BATCH/IDLE
CONFIG_CFS_BANDWIDTH=y
CONFIG_FAIR_GROUP_SCHED=y

# 73 SCHED_FIFO / RR
CONFIG_RT_GROUP_SCHED=y

# 74 SCHED_DEADLINE(全裁)
# 注:Linux 6.6 无独立 CONFIG_SCHED_DEADLINE,SCHED_DEADLINE 调度类代码默认编入
# 全裁通过 cgroup v2 不分配 SCHED_DEADLINE 带宽 + 应用层不调用 sched_setattr(deadline)落实

# 76 cgroup v2 controllers(纯 v2,v1 专属 controller 已分离到 #75)
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y

# 77 isolcpus(命令行参数,非 Kconfig)
# 真实配置:内核启动参数 isolcpus=

# 80 EFI / U-Boot boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# 注:EFI 启动不需要 CONFIG_EFI_VARS(efivarfs 由 EFI 自动挂载)

# 81 ACPI / PSCI(ARM64 PSCI 是 ARM_PSCI_FW,被 ARM64 自动 select)
CONFIG_ACPI=y
# 注:CONFIG_ARM_PSCI_FW 由 ARM64 自动 select,qemu virt machine 默认 PSCI=on
# 片段不显式置值,避免与 ARM64 自动 select 冲突

# 82 earlycon
CONFIG_SERIAL_EARLYCON=y

# 83 arm64 generic timer / qemu virt DTS
# CONFIG_ARM64 / CONFIG_SMP / CONFIG_ARM_ARCH_TIMER 由 ARM64 自动开启,片段不写

# §6 关键 CONFIG_ 单独标记
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_CHECKPOINT_RESTORE=y

# ===== 强制关闭 =====

# 5 SCTP / DCCP / RDS / TIPC / RXRPC
CONFIG_IP_SCTP=n
CONFIG_IP_DCCP=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_RXRPC=n
CONFIG_RXRPC_DEBUG=n

# 6 Appletalk / IPX / DECnet / WAN
# DECnet / IPX 已在 6.6 移除,无 CONFIG_
CONFIG_ATALK=n
CONFIG_X25=n
CONFIG_PHONET=n

# 7 Bluetooth / WiFi 协议栈
CONFIG_BT=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# 8 NFC / IRDA / amateur radio
CONFIG_NFC=n
CONFIG_IRDA=n
CONFIG_AMATEUR_RADIO=n

# 9 CAN / SocketCAN(CI 裁)
CONFIG_CAN=n
CONFIG_CAN_RAW=n
CONFIG_CAN_BCM=n
CONFIG_CAN_GW=n
CONFIG_CAN_DEV=n
CONFIG_CAN_CALC_BITTIMING=n

# 12 overlayfs(CI 裁)
CONFIG_OVERLAY_FS=n

# 13 virtio-9p / virtio-fs(CI 裁,红线)
CONFIG_NET_9P_VIRTIO=n
CONFIG_9P_FS=n
CONFIG_VIRTIO_FS=n

# 14 squashfs(可选,默认关)
CONFIG_SQUASHFS=n

# 15 FUSE(CI 裁;FUSE_FS 独立条目,不混入 #13)
CONFIG_FUSE_FS=n
CONFIG_FUSE_PASSTHROUGH=n

# 16 btrfs / xfs / f2fs / NTFS / exFAT
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NTFS_FS=n
CONFIG_EXFAT_FS=n

# 17 jffs2 / ubifs / cramfs
CONFIG_JFFS2_FS=n
CONFIG_UBIFS_FS=n
CONFIG_CRAMFS=n

# 18 NFS client
CONFIG_NFS_FS=n
CONFIG_NFSD=n

# 23 SELinux / SMACK
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_SMACK=n

# 25 IMA / EVM
CONFIG_INTEGRITY=n
CONFIG_INTEGRITY_MACHINE_KEYRING=n

# 26 LandLock
CONFIG_SECURITY_LANDLOCK=n

# 27 TPM
CONFIG_TCG_TPM=n
CONFIG_TCG_TIS=n
CONFIG_TCG_TIS_I2C=n

# 29 ftrace / perf events(CI 裁)
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_PERF_EVENTS=n

# 30 kprobes / uprobes / bpf syscall / BPF JIT(CI 裁)
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_BPF=n
CONFIG_BPF_SYSCALL=n
CONFIG_BPF_JIT=n
CONFIG_HAVE_EBPF_JIT=n

# 31 kdump / crashkernel
CONFIG_CRASH_DUMP=n

# 32 lockdep / kmemleak / kcsan / KASAN / UBSAN(可选,默认关)
CONFIG_LOCKDEP=n
CONFIG_DEBUG_LOCKDEP=n
CONFIG_DEBUG_KMEMLEAK=n
CONFIG_KCSAN=n
CONFIG_KASAN=n
CONFIG_UBSAN=n

# 33 kgdb / kdb
CONFIG_KGDB=n
CONFIG_KGDB_SERIAL_CONSOLE=n
CONFIG_KGDB_KDB=n
CONFIG_KDB=n

# 35 System V IPC(CI 裁)
CONFIG_SYSVIPC=n

# 36 POSIX mqueue(CI 裁)
CONFIG_POSIX_MQUEUE=n

# 41 DM(device-mapper)(CI 裁)
CONFIG_BLK_DEV_DM=n
CONFIG_DM_CRYPT=n
CONFIG_DM_SNAPSHOT=n
CONFIG_DM_THIN_PROVISIONING=n
CONFIG_DM_ZERO=n
CONFIG_DM_RAID=n
CONFIG_DM_VERITY=n

# 42 md(RAID,可选,默认关)
CONFIG_MD=n

# 43 MFM / RLL / ESDI / IDE / PATA
CONFIG_IDE=n
CONFIG_BLK_DEV_IDE=n

# 44 mtip32xx
CONFIG_BLK_DEV_MTIP32XX=n

# 46 tun / tap(CI 裁)
CONFIG_TUN=n
CONFIG_VETH=n

# 48 virtio-vsock(CI 裁)
CONFIG_VIRTIO_VSOCKETS=n

# 49 virtio-crypto(CI 裁)
CONFIG_CRYPTO_DEV_VIRTIO=n

# 50 全部物理网卡驱动
CONFIG_NET_VENDOR_3COM=n
CONFIG_NET_VENDOR_ADAPTEC=n
CONFIG_NET_VENDOR_AGERE=n
CONFIG_NET_VENDOR_ALACRITECH=n
CONFIG_NET_VENDOR_ALLWINNER=n
CONFIG_NET_VENDOR_AMAZON=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_AQUANTIA=n
CONFIG_NET_VENDOR_ARC=n
CONFIG_NET_VENDOR_ATHEROS=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_CADENCE=n
CONFIG_NET_VENDOR_CAVIUM=n
CONFIG_NET_VENDOR_CHELSIO=n
CONFIG_NET_VENDOR_CISCO=n
CONFIG_NET_VENDOR_CORTINA=n
CONFIG_NET_VENDOR_DAVICOM=n
CONFIG_NET_VENDOR_DEC=n
CONFIG_NET_VENDOR_DLINK=n
CONFIG_NET_VENDOR_EMULEX=n
CONFIG_NET_VENDOR_ENGLEDER=n
CONFIG_NET_VENDOR_EZCHIP=n
CONFIG_NET_VENDOR_FUNGIBLE=n
CONFIG_NET_VENDOR_GOOGLE=n
CONFIG_NET_VENDOR_HUAWEI=n
CONFIG_NET_VENDOR_I825XX=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_MELLANOX=n
CONFIG_NET_VENDOR_MICROCHIP=n
CONFIG_NET_VENDOR_MICROSEMI=n
CONFIG_NET_VENDOR_MYRI=n
CONFIG_NET_VENDOR_NI=n
CONFIG_NET_VENDOR_NATSEMI=n
CONFIG_NET_VENDOR_NETRONOME=n
CONFIG_NET_VENDOR_NVIDIA=n
CONFIG_NET_VENDOR_OKINAWA=n
CONFIG_NET_VENDOR_PACKET_ENGINES=n
CONFIG_NET_VENDOR_PENSANDO=n
CONFIG_NET_VENDOR_QLOGIC=n
CONFIG_NET_VENDOR_QUALCOMM=n
CONFIG_NET_VENDOR_RDC=n
CONFIG_NET_VENDOR_REALTEK=n
CONFIG_NET_VENDOR_RENESAS=n
CONFIG_NET_VENDOR_ROCKER=n
CONFIG_NET_VENDOR_SAMSUNG=n
CONFIG_NET_VENDOR_SEEQ=n
CONFIG_NET_VENDOR_SILAN=n
CONFIG_NET_VENDOR_SIS=n
CONFIG_NET_VENDOR_SMSC=n
CONFIG_NET_VENDOR_SOCIONEXT=n
CONFIG_NET_VENDOR_STMICRO=n
CONFIG_NET_VENDOR_SUN=n
CONFIG_NET_VENDOR_SYNOPSYS=n
CONFIG_NET_VENDOR_TEHUTI=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_VIA=n
CONFIG_NET_VENDOR_WIZNET=n
CONFIG_NET_VENDOR_XILINX=n

# 51 WiFi / WWAN / Bluetooth 设备驱动
CONFIG_WWAN=n
CONFIG_WWAN_HWSIM=n

# 54 virtio-input(CI 裁)
CONFIG_VIRTIO_INPUT=n

# 55 virtio-gpu + DRM / KMS(CI 裁)
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM=n
CONFIG_DRM_KMS_HELPER=n

# 56 framebuffer 简单驱动(CI 裁)
CONFIG_FB=n
CONFIG_FB_SIMPLE=n

# 57 HID / 触摸 / 物理键盘驱动
CONFIG_HID=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_JOYSTICK=n

# 58 声卡
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_SND_PCI=n
CONFIG_SND_USB=n

# 59 SPI / I2C / GPIO(CI 裁,红线)
CONFIG_SPI=n
CONFIG_SPI_SPIDEV=n
CONFIG_I2C=n
CONFIG_I2C_CHARDEV=n
CONFIG_GPIOLIB=n
CONFIG_GPIO_SYSFS=n

# 60 PWM / pwmchip(CI 裁,红线)
CONFIG_PWM=n
CONFIG_PWM_SYSFS=n

# 61 V4L2 / media / videobuf2(CI 裁,红线)
CONFIG_VIDEO_DEV=n
CONFIG_VIDEO_V4L2_SUBDEV_API=n
CONFIG_MEDIA_USB_SUPPORT=n
CONFIG_V4L_PLATFORM_DRIVERS=n

# 62 WATCHDOG / hwmon(CI 裁,红线)
CONFIG_WATCHDOG=n
CONFIG_WATCHDOG_CORE=n
CONFIG_HWMON=n

# 66 USB 控制器驱动(CI 裁,红线)
CONFIG_USB_SUPPORT=n
CONFIG_USB=n
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_EHCI_HCD=n
CONFIG_USB_OHCI_HCD=n

# 68 zswap / zram(可选,默认关)
CONFIG_ZSWAP=n
CONFIG_ZRAM=n

# 69 swap(可选)
CONFIG_SWAP=n

# 70 suspend / hibernate
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n

# 71 NUMA balancing
CONFIG_NUMA_BALANCING=n

# 75 cgroup v1(红线,与 #76 互斥)
# v1 专属 controller 全部关闭,只走 v2
CONFIG_CGROUP_CPUACCT=n
CONFIG_CGROUP_SCHED=n

# 78 CONFIG_MODULES(端到端)— CI 不适用
# 端到端专属决策,CI 端无独立 CONFIG_ 需求;详见 E2E 片段 #78 段

# 79 CONFIG_MODULES(CI 冒烟)— 全裁
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n

# 84 kexec
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n

# 85 NPU 厂商驱动
# 无独立 CONFIG_NPU_*,在 RKNN 树中;此处预留
# (RKNN 驱动不在主线 6.6,仅在厂商分支)

# 86 GPU 厂商驱动
CONFIG_DRM_MALI=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_I915=n

# 87 VPU 视频编解码硬件加速
CONFIG_VIDEO_CODEC_ENCODER=n
CONFIG_VIDEO_CODEC_DECODER=n