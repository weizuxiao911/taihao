# 太昊 OS Extension·MCP 桥配置示例
# 部署路径：/etc/taihao-os/extension-bridge.toml

# 请求 / 响应目录（JSON-RPC 文件协议）
request_dir = "/var/lib/taihao-os/extension-bridge/requests"
response_dir = "/var/lib/taihao-os/extension-bridge/responses"
# 轮询间隔（毫秒）
poll_ms = 200

# 工具白名单（硬边界：MCP 客户端只能调用已注册工具）
[[tools]]
name = "device_status"
command = "cat /var/lib/taihao-os/rt-loop/loop-state.json"
args = []
level = "L3"

[[tools]]
name = "report"
command = "echo report"
args = ["message"]     # 只允许注入白名单参数（shell 安全转义）
level = "L2"
