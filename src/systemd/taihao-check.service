[Unit]
Description=Taihao OS · Service Integration Check (verify 5 services active + whitelist + frequency)
Documentation=man:taihao-os
After=multi-user.target

[Service]
Type=oneshot
# 等待 5 服务启动 + 让 audit log 写入,然后跑验收
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/taihao-check.sh
RemainAfterExit=true
User=root
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=true
User=root
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target