# 太昊 OS 高频实时回路配置示例
# 部署路径：/etc/taihao-os/rt-loop.toml

# 回路频率（Hz），10~100（超出范围自动收敛）
frequency_hz = 50
# Pi Agent 决策文件（mode/target，≤1Hz 下发）
decision_file = "/var/lib/taihao-os/pi-agent/decision.json"
# 状态输入文件（可选）
# state_file = "/var/lib/taihao-os/state.json"
# 执行器输出文件（JSON）
actuator_file = "/var/lib/taihao-os/rt-loop/actuator.json"
# 回路状态文件（JSON）
loop_state_file = "/var/lib/taihao-os/rt-loop/loop-state.json"
# 允许的模式集合（超出视为非法，降级 idle）
allowed_modes = [
    "idle",
    "survey",
    "return",
    "emergency_stop",
    "emergency_surface",
    "emergency_avoidance",
]
