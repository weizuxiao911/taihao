# 太昊 OS · 树莓派 Pi 4B 板型(基座 OS 真机批次)
# 依据:docs/linux-内核裁剪方案.md §8(真机配置分离)+ AGENTS.md 技术选型
# 基板:官方 raspberrypi4_64_defconfig(Buildroot 2024.05)+ 太昊 5 服务包

# ===== 架构 =====
BR2_aarch64=y
BR2_cortex_a72=y

# ===== 内核(树莓派官方内核 bcm2711)=====
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,17f135b742c4edb340afb365873c3a574f7e16cb)/linux-17f135b742c4edb340afb365873c3a574f7e16cb.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# ===== 树莓派固件 =====
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_TAIHAO_PI4B_PATH)/board/raspberrypi4-64/config_4_64bit.txt"

# ===== 工具链 =====
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ===== init / 基础 =====
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_OPENSSL=y

# ===== 太昊 OS 服务层 =====
BR2_PACKAGE_TAIHAO=y
BR2_PACKAGE_PI_AGENT=y
BR2_PACKAGE_RT_LOOP=y
BR2_PACKAGE_HAL_GATEWAY=y
BR2_PACKAGE_COMM_CENTER=y
BR2_PACKAGE_EXTENSION_BRIDGE=y

# ===== rootfs overlay + 脚本 =====
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TAIHAO_PI4B_PATH)/overlays/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_TAIHAO_PI4B_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_TAIHAO_PI4B_PATH)/scripts/post-image.sh"

# ===== 文件系统镜像 =====
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"

# ===== SD 卡镜像工具 =====
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# ===== Rust 工具链(服务层交叉编译)=====
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_CARGO=y
BR2_PACKAGE_HOST_RUSTC_ARCH_EXTENSION="+crc"

# ===== 杂项 =====
BR2_CCACHE=y
BR2_PACKAGE_CA_CERTIFICATES=y
