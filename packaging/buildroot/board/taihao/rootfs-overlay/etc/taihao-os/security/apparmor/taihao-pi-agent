# 太昊 OS Pi Agent AppArmor profile 模板
# 部署：/etc/apparmor.d/taihao-pi-agent
# 加载：apparmor_parser -r /etc/apparmor.d/taihao-pi-agent
# 说明：与 systemd unit 沙箱叠加（纵深防御）；路径按实际部署调整

abi <abi/4.0>,
include <tunables/global>

profile taihao-pi-agent /usr/bin/pi-agent {
  include <abstractions/base>

  # 可执行文件与动态库
  /usr/bin/pi-agent mr,
  /usr/lib/** mr,

  # 配置与 SKILL（只读）
  /etc/taihao-os/pi-agent.toml r,
  /etc/taihao-os/skills/** r,
  /usr/share/taihao-os/skills/** r,

  # 决策输出（写）
  /var/lib/taihao-os/pi-agent/decision.json rw,
  /var/lib/taihao-os/pi-agent/ rw,

  # 网络：仅远程 LLM 端点（按厂商配置收紧）
  network inet stream,
  network inet6 stream,

  # 其余一律拒绝
  deny /dev/** rw,
  deny /sys/** rw,
}
