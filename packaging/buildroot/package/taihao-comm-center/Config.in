config BR2_PACKAGE_TAIHAO_COMM_CENTER
	bool "taihao-comm-center"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  太昊 OS 中台调度通信模块 — 双链路选择 + 消息路由 + 故障切换。

	  远程链路（SSE/WS/MQTT，4G/5G 通道）+ 本地 Mesh（UDP 自组网）；
	  配置 /etc/taihao-os/comm-center.toml；
	  状态 /var/lib/taihao-os/comm-center/status.json。
	  对接对象由厂商配置决定。
