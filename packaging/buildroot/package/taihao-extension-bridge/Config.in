config BR2_PACKAGE_TAIHAO_EXTENSION_BRIDGE
	bool "taihao-extension-bridge"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  太昊 OS Extension·MCP 桥 — JSON-RPC 桥接 + 工具白名单 + 权限边界。

	  请求目录 /var/lib/taihao-os/extension-bridge/requests；
	  配置 /etc/taihao-os/extension-bridge.toml。
	  运行于受限沙箱（无 capabilities，无网络）。
