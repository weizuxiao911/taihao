config BR2_PACKAGE_TAIHAO_RT_LOOP
	bool "taihao-rt-loop"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  太昊 OS 高频实时回路 — 10~100Hz 运动控制骨架。

	  消费 /var/lib/taihao-os/pi-agent/decision.json（≤1Hz 目标/模式）；
	  输出 /var/lib/taihao-os/rt-loop/actuator.json；
	  配置 /etc/taihao-os/rt-loop.toml。
	  运行于受限沙箱（无 capabilities）。
