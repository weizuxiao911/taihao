[Unit]
Description=Taihao OS RT Loop - 高频实时回路 10~100Hz
After=pi-agent.service
Requires=pi-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/rt-loop --config /etc/taihao-os/rt-loop.toml
Restart=on-failure
RestartSec=5
# 受限沙箱：无 capabilities，不碰 /dev（硬件指令经 HAL 网关执行）
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/taihao-os

[Install]
WantedBy=multi-user.target
