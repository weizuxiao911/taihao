# 太昊 OS — Buildroot defconfig
# 目标硬件：RK3588 同级别（aarch64）
# 存储：16GB eMMC
# 三分区：ro 系统 / rw 配置 / rw 业务
# 仿真：QEMU aarch64 必须可启动

# ===== 架构 =====
BR2_aarch64=y
BR2_cortex_a76_a55=y
BR2_ARM_FPU_VFPV4=y

# ===== Toolchain =====
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ===== 内核 =====
# Linux 6.6 LTS + PREEMPT_RT（RT patch 由 BR2_LINUX_KERNEL_PATCH 注入）
BR2_KERNEL_HEADERS_6_6=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.46"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_PATCH=y
BR2_LINUX_KERNEL_PREEMPT_RT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# ===== Init =====
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="taihao"
BR2_SYSTEM_BIN_SH_BASH=y

# ===== Filesystem =====
# 三分区：ro 系统分区（squashfs）+ 一块 rw 配置 / 业务
# ext4 用于 QEMU 仿真启动（squashfs 仅只读，QEMU 挂载不便）
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_OVERLAY=y

# ===== 安全 =====
BR2_PACKAGE_APPARMOR=y
BR2_PACKAGE_APPARMOR_PROFILES=y
BR2_PACKAGE_APPARMOR_UTILS=y
BR2_PACKAGE_LINUX_FIRMWARE=y

# ===== 网络 =====
# 802.11s（Mesh）+ Wi-Fi 5/6
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_MESH_NETWORK=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_IWD=y

# ===== 中台调度通信模块依赖 =====
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y

# ===== 基础工具 =====
BR2_PACKAGE_GIT=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_JQ=y
BR2_PER_PACKAGE_DIRECTORIES=y

# ===== 太昊 OS 自研包（占位，待 src/ 落地后启用） =====
# BR2_PACKAGE_TAIHAO_PI_AGENT=y
# BR2_PACKAGE_TAIHAO_HAL_GATEWAY=y
# BR2_PACKAGE_TAIHAO_COMM_CENTER=y
# BR2_PACKAGE_TAIHAO_EXTENSION_BRIDGE=y

# ===== 启动优化 =====
BR2_INIT_SYSTEMD_DEFAULT_TARGET=multi-user.target
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVVMPATH=y
